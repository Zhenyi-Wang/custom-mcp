use_default_settings: true

general:
  debug: false
  instance_name: "custom-mcp"

search:
  formats:
    - html
    - json

server:
  port: 8080
  bind_address: "0.0.0.0"
  secret_key: "change-me-in-production"
  limiter: false
  method: "GET"

# 上游引擎 TLS 指纹风控(2026-08 集中爆发,searxng#6596):httpx 的 Python
# TLS 指纹配 Firefox UA 被识别为机器人,换出口 IP 无效。需配合
# ghcr.io/ikidd/searxng-impersonate 镜像(PR searxng#5476),以真实浏览器
# TLS/HTTP 指纹出站;use_default_settings 下仅按 name 覆盖对应字段。
engines:
  - name: brave
    network:
      impersonate: "chrome"
  - name: duckduckgo
    network:
      impersonate: "firefox"
  # startpage 已上 Anubis PoW 防护(2026-08,searxng#6520):挑战要求执行
  # JS 计算,浏览器无感通过、SearXNG 无法通过,手动过码/impersonate 均无效;
  # 待上游 PoW solver(vojkovic/searxng cffi 分支)并入后再启用
  - name: startpage
    disabled: true
  # Brave 官方 API:走 api.search.brave.com + key 认证,不经网页风控,
  # 作为免费层兜底(默认条目 inactive: true,须显式启用)
  - name: braveapi
    api_key: "${BRAVE_API_KEY}"
    inactive: false
    disabled: false
  # 免费渠道扩充结论:
  # - mojeek 自有索引,但对 oracle 出口 IP 稳定 403,disabled 待命
  # - marginalia 当前用官方公共 key "public"(.env 的 MARGINALIA_API_KEY,
  #   常触发限速,不能自定义过滤;正式 key 免费申请:
  #   about.marginalia-search.com/article/api,拿到改 .env 即可)。
  #   坑:engines= 指定未加载引擎时 SearXNG 会静默退化为默认引擎集,
  #   结果全是他家条目,极易误判
  # - karmasearch 对本出口稳定 403,每次聚合白打请求并污染 unres,禁用
  # - 公共 SearXNG 实例聚合实测被 limiter+JSON 禁用全面封死,不采用
  - name: mojeek
    disabled: true
  - name: marginalia
    api_key: "${MARGINALIA_API_KEY}"
    inactive: false
    disabled: false
  - name: karmasearch
    disabled: true
  - name: karmasearch videos
    disabled: true
