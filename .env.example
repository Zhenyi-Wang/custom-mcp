# 复制为 .env 后填写;密钥备份在 oracle:/root/secrets/custom-mcp.env,
# 恢复说明见 CLAUDE.md「密钥与恢复」

# mcp-server Bearer 鉴权(生产 compose 注入;本地试跑同用)
# 生成: openssl rand -hex 32
MCP_TOKEN=

# SearXNG 引擎密钥:由 sync.sh envsubst 渲染进 searxng/settings.yml,
# 模板占位符见 searxng/settings.yml.example
BRAVE_API_KEY=       # Brave Search API,https://api-dashboard.search.brave.com/
MARGINALIA_API_KEY=  # marginalia 免费申请,https://about.marginalia-search.com/article/api/
